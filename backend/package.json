{
  "name": "dtu-upcycled-3d-backend",
  "version": "1.0.0",
  "description": "Backend API for Upcycled Fishing Net & Ocean Accessories E-Commerce with Free-form 3D Customizer & Cloudinary Media Storage",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrations/migrator.js",
    "migrate:status": "node src/migrations/migrator.js status",
    "migrate:force": "node src/migrations/migrator.js force",
    "seed": "node src/seeds/seed.js",
    "cloudinary:sync": "node src/scripts/syncToCloudinary.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^4.6.7"
  }
}
