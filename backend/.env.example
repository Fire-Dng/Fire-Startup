PORT=5000
NODE_ENV=development
BACKEND_PUBLIC_URL=http://localhost:5000

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/dtu_upcycled_3d
LOCAL_FALLBACK_MONGODB_URI=mongodb://127.0.0.1:27017/dtu_upcycled_3d

# JWT Security
JWT_SECRET=replace-with-your-jwt-secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3002,http://127.0.0.1:5173

# Shipping & Order Pricing Rules
FREE_SHIPPING_THRESHOLD=500000
DEFAULT_SHIPPING_FEE=30000

# VietQR Payment Configuration
VIETQR_BANK_ID=MB
VIETQR_BANK_NAME=MB - Ngân hàng Quân Đội (MB Bank)
VIETQR_ACCOUNT_NO=0905123456
VIETQR_TEMPLATE=compact2
VIETQR_ACCOUNT_NAME=CONG TY TAI CHE LUOI BIEN DTU
VIETQR_BASE_URL=https://img.vietqr.io/image

# Seed Accounts
SEED_ADMIN_EMAIL=admin@dtu-upcycled.vn
SEED_STAFF_EMAIL=artisan@dtu-upcycled.vn
SEED_CUSTOMER_EMAIL=customer@dtu-upcycled.vn
SEED_DEFAULT_PASSWORD=Password123!

# Cloudinary Media Storage
# You can either provide CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# OR set CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, and CLOUDINARY_API_SECRET individually:
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER_PREFIX=wavo
CLOUDINARY_UPLOAD_PRESET=
MEDIA_PUBLIC_BASE_URL=
MEDIA_SIGNED_EXPIRES_IN=300
UPLOAD_MAX_FILE_SIZE_MB=5

# Render Anti-Sleep Keep-Alive Heartbeat
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MINUTES=8
