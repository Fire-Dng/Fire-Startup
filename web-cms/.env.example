# ==============================================================================
# ENVIRONMENT VARIABLES — WEB CMS (web-cms/)
# ==============================================================================

# URL Backend API
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL Web Store & Web CMS
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_CMS_URL=http://localhost:3002

# Cloudinary Media Storage
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_CLOUDINARY_BASE_URL=
NEXT_PUBLIC_MEDIA_BASE_URL=

# VietQR Fallback
NEXT_PUBLIC_VIETQR_FALLBACK_URL=https://img.vietqr.io/image/MB-0905123456-compact2.png

# Demo Admin Credentials (cho moi truong thu nghiem)
NEXT_PUBLIC_DEFAULT_ADMIN_EMAIL=admin@dtu-upcycled.vn
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD=Password123!

# Chu ky (phut) tu dong gui request danh thuc Backend Render
NEXT_PUBLIC_KEEP_ALIVE_MINUTES=8
